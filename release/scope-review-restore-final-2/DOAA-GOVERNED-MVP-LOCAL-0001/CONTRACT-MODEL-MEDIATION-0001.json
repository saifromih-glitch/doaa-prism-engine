{
  "contract_id": "CONTRACT-MODEL-MEDIATION-0001",
  "version": "1.1",
  "message_kind": "model_proposal_envelope",
  "required_fields": ["message_id", "model_id", "proposal", "execution_authority"],
  "proposal_type": "structured_data_only",
  "route_order": ["exact_registry_lookup", "governed_model_proposal_on_miss", "bounded_repair", "proposal_gate", "human_review", "safe_execution"],
  "cache_hit": {"model_call": false, "automatic_execution": false, "output_kind": "non_executable_candidate"},
  "cache_miss": {"model_call": true, "automatic_execution": false, "output_kind": "untrusted_non_executable_proposal"},
  "model_output_is_untrusted": true,
  "exact_match_only": true,
  "execution_authority": "none",
  "automatic_execution": false,
  "human_review_required": true,
  "allowed_model_role": "proposal_assistant",
  "prohibited_roles": ["executor", "installer", "publisher", "self_modifier"],
  "prohibited_content": ["shell_command", "source_code", "credentials", "network_instruction", "arbitrary_file_operation"],
  "writes_files": false,
  "modifies_source": false,
  "network_request": false,
  "secret_access": false,
  "subprocess": false,
  "generated_code": false,
  "fail_closed": true
}
