{
  "contract_id": "CONTRACT-LOCAL-INTEGRATION-0001",
  "version": "1.1",
  "accepted_message_kind": "governed_request_envelope",
  "required_fields": ["request_id", "payload", "execution_authority"],
  "execution_authority": "none",
  "automatic_execution": false,
  "allowed_transport": "local_in_process_only",
  "allowed_payload": "structured_json_only",
  "payload_max_bytes": 16384,
  "payload_max_depth": 8,
  "payload_value_types": ["null", "boolean", "number", "string", "array", "object"],
  "recursive_forbidden_key_scan": true,
  "prohibited_payloads": ["shell_command", "source_code", "subprocess_request", "network_request", "secret", "arbitrary_path_write"],
  "human_review_required": true,
  "fail_closed": true,
  "source_modified": false
}
