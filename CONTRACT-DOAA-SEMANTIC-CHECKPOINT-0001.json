{
  "contract": "doaa.semantic_checkpoint.v1",
  "purpose": "Lossless local context checkpoint with compact reversible references.",
  "design": {
    "source_text_is_immutable": true,
    "compact_reference_is_not_a_summary": true,
    "cold_session_requires_source_payload": true,
    "warm_session_may_use_checkpoint_id": true,
    "expansion_must_return_original_spans": true
  },
  "critical_fields": ["numbers", "negation_markers", "dates", "units", "named_tokens", "sentence_order"],
  "rules": {
    "unknown_checkpoint_blocks": true,
    "unknown_segment_blocks": true,
    "checksum_mismatch_blocks": true,
    "semantic_truth_not_claimed": true,
    "automatic_model_memory_assumption": false
  },
  "automatic_execution": false,
  "execution_authority": "none"
}
